#!/bin/sh
#
# S53-ecu-zb — start the ecu-zb ZigBee proxy.
#
# ecu-zb owns /dev/ttyO2 and cannot share it with the stock main.exe. start()
# refuses to run while the stock inverter stack (main.exe/monitor.exe) is up —
# disable stock first (opkg remove apsystems-stock). opkg 0.1.8 ignores the
# Conflicts field, so this start-time guard is the enforcement.
#
# ecu-zb autodetects the ZigBee coordinator PAN from /etc/yuneng/ecu_eth0_mac.conf
# (authoritative and readable from early boot), else the live eth0 MAC, so boot
# ordering is not critical for the PAN. It runs at S53 (after S50ecu_init) where
# /dev/reset + kernel modules are up for the radio hardware-reset bring-up.
#
# Install (one-time):
#   ssh ecu 'cat > /etc/rcS.d/S53-ecu-zb' < S53-ecu-zb
#   ssh ecu 'chmod +x /etc/rcS.d/S53-ecu-zb'

BIN=/home/applications/ecu-zb/ecu-zb
RUN=/home/applications/ecu-zb/run
# ecu-zb owns its rotated log via --log-file; the init redirect only captures
# pre-logging flag errors and Go runtime panics.
LOG=/var/log/ecu-zb.log
BOOTLOG=/var/log/ecu-zb.boot.log
PIDFILE=$RUN/ecu-zb.pid
ARGS="--proxy --tty /dev/ttyO2 --pty $RUN/zb-pty --tap-sock $RUN/pcap.sock --tap-tcp 0.0.0.0:19999 --invdriver-sock /var/run/inv-driver.sock --log-file $LOG"

start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "ecu-zb already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    # Guard: the stock inverter stack must be disabled first — main.exe and
    # ecu-zb cannot both own /dev/ttyO2. Refuse rather than fight for the bus.
    if pidof main.exe monitor.exe >/dev/null 2>&1; then
        echo "ecu-zb: stock inverter stack (main.exe/monitor.exe) is running and owns /dev/ttyO2 — NOT starting."
        echo "  Disable stock first:  opkg remove apsystems-stock  (then reboot), then: $0 start"
        return 0
    fi
    [ -x "$BIN" ] || { echo "$BIN missing or not executable"; return 1; }
    mkdir -p "$RUN" /var/log

    # Supervised respawn loop under nohup: the loop shell's PID is the pidfile
    # PID and it re-launches ecu-zb whenever ecu-zb exits. ecu-zb repairs the
    # faults it can in-process (it reopens the modem port on a tty hangup and
    # the pty master on EIO), so reaching this loop means it gave up —
    # proxy.ErrModemFault, ErrHostFault, or a panic. Without the loop those
    # leave the radio unattended until the next reboot. Restart is safe:
    # ecu-zb resumes from an already-staged <tty>.real rather than re-renaming
    # (see captureRealUART).
    #
    # nohup + </dev/null detach the loop so it survives both boot-time
    # invocation (init(1) ancestor) and the PHP-FPM firmware-update endpoint
    # context, where a plain `nohup BIN &` gets reaped when the request
    # returns. The 10s pause keeps a binary that dies instantly (bad flags,
    # busy tty) from becoming a hot loop.
    nohup sh -c "echo \$\$ > '$PIDFILE'
        while :; do
            '$BIN' $ARGS
            echo \"ecu-zb exited (rc=\$?), respawning in 10s\"
            sleep 10
        done" </dev/null >> "$BOOTLOG" 2>&1 &
    sleep 1
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null && pidof ecu-zb >/dev/null 2>&1; then
        echo "ecu-zb started (supervisor pid $(cat "$PIDFILE"))"
    else
        echo "ecu-zb failed to stay up; check $LOG and $BOOTLOG"
        return 1
    fi

    # Wait for the pty symlink to appear so the next init script
    # (S50ecu_init → manager → monitor.exe → main.exe) finds it.
    i=0
    while [ $i -lt 20 ]; do
        if [ -L /dev/ttyO2 ] && [ -e /dev/ttyO2.real ]; then
            echo "ecu-zb ready: /dev/ttyO2 -> $(readlink /dev/ttyO2)"
            return 0
        fi
        sleep 1
        i=$((i+1))
    done
    echo "ecu-zb did not publish pty within 20s"
    return 1
}

stop() {
    # Step 1: kill the supervisor loop via the pidfile FIRST, so it stops
    # respawning before we kill the binary it launched.
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        kill "$PID" 2>/dev/null
        rm -f "$PIDFILE"
    fi

    # Step 2: kill the ecu-zb --proxy process the loop launched (a child, or an
    # orphan once the loop is gone), and any left by a stale pidfile or a
    # double start.  `pidof` is available on BusyBox; `pgrep` is not.
    for P in $(pidof ecu-zb 2>/dev/null); do
        kill "$P" 2>/dev/null
    done

    # Step 3: escalate with SIGKILL after a short grace period.
    sleep 2
    for P in $(pidof ecu-zb 2>/dev/null); do
        kill -9 "$P" 2>/dev/null
    done

    # Step 4: wait for tcp :19999 to be free (up to 8 s) so the next `start`
    # can bind without "address already in use".  `netstat -ltn` is BusyBox-safe.
    i=0
    while [ $i -lt 8 ]; do
        if ! netstat -ltn 2>/dev/null | grep -q ':19999 '; then
            break
        fi
        sleep 1
        i=$((i+1))
    done

    echo "ecu-zb stopped"
}

status() {
    # The pidfile holds the supervisor loop; report the binary separately so a
    # crash-looping ecu-zb is not mistaken for a healthy one.
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        if pidof ecu-zb >/dev/null 2>&1; then
            echo "running (supervisor pid $(cat "$PIDFILE"), ecu-zb pid $(pidof ecu-zb))"
        else
            echo "supervised but ecu-zb is down (respawning); check $LOG and $BOOTLOG"
            exit 1
        fi
    else
        echo "stopped"
        exit 1
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *)
        echo "usage: $0 {start|stop|restart|status}"
        exit 2
        ;;
esac
