#!/bin/sh
# postinst — openaps-busybox
#
# The server list (/etc/ntpdate/servers.conf) ships as a conffile, so opkg
# preserves operator edits across upgrades.
#
# The clock daemon runs from the default runlevel at /etc/rc5.d/S99-ntpdate,
# AFTER the runlevel's `hwclock --hctosys` (rc5.d/S20hwclock.sh) — which reads
# the dead RTC and would otherwise clobber the clock. Remove the legacy rcS.d
# location shipped by v1.1.25/26 (it ran before the runlevel and got clobbered),
# then (re)start now. `|| true` so a slow first sync does not fail package
# configuration — the daemon self-retries and it also starts at boot.
set -e

rm -f /etc/rcS.d/S56-ntpdate

if [ -x /etc/rc5.d/S99-ntpdate ]; then
    /etc/rc5.d/S99-ntpdate restart || true
fi

exit 0
