#!/bin/sh
#
# openaps-ntpd — keep the RTC-less ECU clock in step with the Debian NTP pool.
#
# Runs busybox ntpd as a persistent client daemon under a supervisor loop: ntpd
# steps a large offset on the first good sync then disciplines continuously, but
# busybox ntpd exits right after a step (a post-step recv EBADF), so the loop
# respawns it — the next instance sees a corrected clock, does not step, and
# stays up.
#
# Installed as /etc/rc5.d/S99-ntpdate — in the default runlevel, AFTER
# rc5.d/S20hwclock.sh runs `hwclock --hctosys`. That hctosys reads the dead,
# unwritable RTC (permanently 2000) and clobbers any earlier clock set; the whole
# of rcS.d runs BEFORE the runlevel, so an rcS.d clock-setter always loses to it.
# Running last in the runlevel makes ntpd's correction stick. ntpd cannot step a
# ~26-year offset, so start() first pre-nudges the clock to a recent baseline.
#
# The binary is the static (musl) busybox-openaps; its ntpd applet links no
# OpenSSL, so it is immune to the stock firmware's OpenSSL version.

BIN=/usr/local/bin/busybox-openaps
CONF=/etc/ntpdate/servers.conf
RUN=/var/run
PIDFILE=$RUN/ntpdate.pid
LOG=/var/log/ntpd.log

NTPSERVERS=
[ -f "$CONF" ] && . "$CONF"

start() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "ntpd already running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    [ -x "$BIN" ] || { echo "$BIN missing or not executable"; return 1; }
    [ -n "$NTPSERVERS" ] || { echo "NTPSERVERS not set in $CONF"; return 1; }
    mkdir -p "$RUN" /var/log

    # Reset the log each start so it can't grow unbounded over the device's
    # lifetime: busybox ntpd has no internal rotation and appends step/error
    # lines to $LOG forever otherwise. Truncating per start keeps only the
    # current daemon's output.
    : > "$LOG"

    # No battery-backed RTC: a cold boot can start at 1970/2000, and busybox ntpd
    # will not step a decade-wide offset — so baseline the clock to a recent time
    # first, leaving ntpd only a small offset to discipline. Prefer the last-good
    # /etc/timestamp mtime (written at shutdown), else a built-in floor.
    #
    # Trust the timestamp ONLY if its mtime is itself post-2020: a box that shut
    # down still stuck at 2000 writes a 2000 timestamp, which would otherwise
    # re-pin the clock to 2000 every boot (a self-perpetuating stuck clock). Fall
    # back to the floor in that case so ntpd can always step.
    #
    # Use the shipped busybox for date so -r/-s support never depends on whatever
    # /bin/date is; date -r reads the file's mtime, not its contents.
    if [ "$("$BIN" date +%Y)" -lt 2020 ]; then
        base="2026-06-01 00:00:00"
        if [ -f /etc/timestamp ] && [ "$("$BIN" date -r /etc/timestamp +%Y)" -ge 2020 ] 2>/dev/null; then
            base="$("$BIN" date -r /etc/timestamp '+%Y-%m-%d %H:%M:%S')"
        fi
        "$BIN" date -s "$base" >/dev/null 2>&1 || true
    fi

    # busybox ntpd wants a repeatable -p per peer, not a space-separated list.
    # Hostnames carry no spaces/globs, so the unquoted expansion below is safe.
    PARGS=
    for s in $NTPSERVERS; do
        PARGS="$PARGS -p $s"
    done

    # Supervised respawn loop under nohup: the loop shell's PID is the pidfile
    # PID; it re-launches ntpd whenever ntpd exits. This matters because busybox
    # ntpd exits right after it STEPS a large offset (a post-step recv EBADF).
    # At boot the clock is wrong, so the first ntpd steps it and dies; the loop
    # restarts it, and the next instance sees a now-correct clock, does not step,
    # and stays up to discipline continuously. The 30s pause avoids a hot loop if
    # ntpd ever exits immediately. nohup + </dev/null detach the loop so it
    # survives init(1) boot and the PHP-FPM upgrade-endpoint context (same reason
    # as S48-inv-driver). Step/error lines go to $LOG.
    nohup sh -c "echo \$\$ > '$PIDFILE'
        while :; do
            '$BIN' ntpd -n $PARGS
            sleep 30
        done" </dev/null >> "$LOG" 2>&1 &
    sleep 1
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "ntpd started (pid $(cat "$PIDFILE"))"
    else
        echo "ntpd failed to stay up; check $LOG"
        return 1
    fi
}

stop() {
    # Kill the supervisor loop first (via the pidfile) so it stops respawning,
    # then kill the ntpd instance it launched (a child, or an orphan after the
    # loop dies). pidof matches the vendored binary basename.
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    P=$(pidof busybox-openaps 2>/dev/null)
    if [ -n "$P" ]; then
        kill $P 2>/dev/null
        echo "ntpd stopped"
    else
        echo "ntpd not running"
    fi
}

status() {
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "running (pid $(cat "$PIDFILE"))"
    else
        echo "stopped"
        exit 1
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  status ;;
    *)
        echo "usage: $0 {start|stop|restart|status}"
        exit 2
        ;;
esac
